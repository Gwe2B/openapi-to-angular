{
  "name": "openapi-to-angular",
  "version": "0.1.0",
  "description": "CLI to generate Angular code from OpenAPI specifications",
  "type": "module",
  "bin": {
    "openapi-to-angular": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "preversion": "npm run lint && npm run typecheck && npm test",
    "prepare": "npm run build"
  },
  "keywords": [
    "openapi",
    "angular",
    "cli",
    "codegen"
  ],
  "author": "Gwenaël",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gwe2B/openapi-to-angular.git"
  },
  "bugs": {
    "url": "https://github.com/Gwe2B/openapi-to-angular/issues"
  },
  "homepage": "https://github.com/Gwe2B/openapi-to-angular#readme",
  "dependencies": {
    "commander": "^13.1.0",
    "js-yaml": "^4.1.0",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
